# Copy to .env (never commit .env). Every key can also be entered in the app: Settings -> Connectors.
# Environment variables win over keys stored by the app.

# Where SessionDesk keeps settings, keys, cache and the news archive (default: ~/.sessiondesk)
# SESSIONDESK_HOME=

# AI (bring your own key - pick one or several)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Data connectors (all optional - the free core runs without any key)
# SESSIONDESK_FINNHUB_API_KEY=
# SESSIONDESK_FMP_API_KEY=
# SESSIONDESK_POLYGON_API_KEY=
# SESSIONDESK_ALPHAVANTAGE_API_KEY=
# SESSIONDESK_TRADINGECONOMICS_API_KEY=
# SESSIONDESK_ALPACA_KEY_ID=
# SESSIONDESK_ALPACA_SECRET_KEY=
